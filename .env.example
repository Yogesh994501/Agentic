# SentinelFlow Environment Configuration
APP_NAME=SentinelFlow
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=sentinelflow

# AI / LLM Configuration
LLM_PROVIDER=mock
DEMO_MODE=true
GEMINI_API_KEY=
OPENAI_API_KEY=

# Autonomous Agent Policy
CONFIDENCE_THRESHOLD=80
MAX_INVESTIGATION_STEPS=8
AUTO_RESPONSE_ENABLED=true
